# Next.js reads env from THIS app directory, not the repo root. Copy this file to
# apps/web/.env.local and fill in what you need:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# The repo-root .env is used by the scripts/agent/CLI; this one is for the running
# web app (control plane + Approval Console + copilot).

# ── Databases (match docker-compose.yml) ───────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5435/sentinel
TARGET_DB_URL=postgres://postgres:postgres@localhost:5433/prod
SHADOW_ADMIN_URL=postgres://postgres:postgres@localhost:5434/postgres

# The "add a connection" API (POST /api/connections) blocks private/internal
# network addresses by default (SSRF protection). docker-compose DB hosts are on
# localhost (a private address), and PaaS deployments (Zerops/Fly/Railway) put the
# databases on an internal network — set this to 1 there so those targets can be
# added. Only enable where every operator who can add a connection is already
# trusted to reach internal infrastructure.
ALLOW_PRIVATE_DB_HOSTS=1

# ── Single-approver auth ───────────────────────────────────────────────
# The token the Approval Console validates. Must match the repo-root .env.
APPROVER_TOKEN=change-me
# Demo: pre-fill the login token so the console is one click ("Login to
# Console") away. Must equal APPROVER_TOKEN. Leave UNSET in production.
NEXT_PUBLIC_DEMO_TOKEN=change-me
# Demo: open the console with NO login (every visitor becomes the approver).
# OFF by default. NEVER enable in a real deployment — it makes the approval gate
# unauthenticated. To run the no-login demo, set BOTH to 1:
#   DEMO_OPEN_ACCESS            — SERVER-side gate (runtime; the security boundary)
#   NEXT_PUBLIC_DEMO_OPEN_ACCESS — client-side only (which link the CTAs point to)
DEMO_OPEN_ACCESS=
NEXT_PUBLIC_DEMO_OPEN_ACCESS=

# ── GitHub (PR intake, verdict comments, export-PR gate) ───────────────
# Personal-access token with `repo` scope. Unset → the PR features are off.
GITHUB_TOKEN=
# Public base URL of THIS console, used in the verdict comment posted to a
# public PR so its "open in console" link is reachable — not localhost. Leave
# unset locally (falls back to the request origin). No trailing slash.
APP_BASE_URL=

# ── Copilot chat — BYOK, OpenAI-compatible (Euron / EURI) ──────────────
# Paste your Euron key to enable the read-only "Ask about this migration"
# copilot. Empty → the copilot renders but is disabled ("configure key").
EURON_API_KEY=
EURON_BASE_URL=https://api.euron.one/api/v1/euri
EURON_MODEL=gpt-4.1-nano

# ── TrueForge (optional — only for generating SQL from an English intent) ─
TRUEFORGE_BASE_URL=http://localhost:8790

# ── Qodo (optional, advisory — unset → review skipped) ─────────────────
# QODO_API_KEY=
