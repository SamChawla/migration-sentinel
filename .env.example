# ── Control-plane (our own state) ──────────────────────────────────────
# Host port 5435 — docker-compose publishes sentinel-db there (5432 is often
# taken by a local Postgres). Must match docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5435/sentinel

# ── Target DB (the database the agent migrates) ────────────────────────
# NOTE: this demo uses a superuser URL for simplicity. In production, supply a
# READ-ONLY role here — the agent only reads the target during analysis/pre-flight;
# the single write happens in the guarded apply step, which should use a separate
# write credential. Do not treat this superuser URL as the read-only gate.
TARGET_DB_URL=postgres://postgres:postgres@localhost:5433/prod

# ── Shadow DB admin (ephemeral clones are created/dropped here) ────────
SHADOW_ADMIN_URL=postgres://postgres:postgres@localhost:5434/postgres
# Used by the rollback integration tests:
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5434/shadow

# ── TrueForge (only for NL-intent → SQL generation; raw-SQL intake needs none) ──
TRUEFORGE_BASE_URL=http://localhost:8790
# Local server (`npx @truefoundry/trueforge`) runs with auth OFF — no token needed.
# Set this ONLY when pointing at a hosted / auth-enabled TrueForge:
TRUEFORGE_TOKEN=
# The model-provider key the TrueForge SERVER uses to run the LLM turn. Register
# it with the server (env at launch or settings.modelProviders) — model is
# anthropic/claude-sonnet-4-6. This is the key the generation step actually needs.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub (PR intake, optional) ───────────────────────────────────────
GITHUB_TOKEN=

# ── Qodo (code review) ─────────────────────────────────────────────────
QODO_API_KEY=

# ── Auth (single approver for the hackathon) ───────────────────────────
APPROVER_TOKEN=change-me
