# ── Control-plane (our own state) ──────────────────────────────────────
# Host port 5435 — docker-compose publishes sentinel-db there (5432 is often
# taken by a local Postgres). Must match docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5435/sentinel

# ── Target DB (the database the agent migrates) ────────────────────────
# NOTE: this demo uses a superuser URL for simplicity. In production, supply a
# READ-ONLY role here — the agent only reads the target during analysis/pre-flight;
# the single write happens in the guarded apply step, which should use a separate
# write credential. Do not treat this superuser URL as the read-only gate.
TARGET_DB_URL=postgres://postgres:postgres@localhost:5433/prod

# ── Promotion-ladder lower rungs (seeded as dev/staging connections) ───
# docker-compose publishes dev-db on 5437 and staging-db on 5436. The control-
# plane seed registers dev-orders-db + staging-orders-db against these so the
# full dev → staging → prod ladder is runnable end-to-end. Give each its OWN URL —
# a missing STAGING/DEV URL would fall back to TARGET_DB_URL (prod), letting a
# "dev" migration hit production.
DEV_DB_URL=postgres://postgres:postgres@localhost:5437/dev
STAGING_DB_URL=postgres://postgres:postgres@localhost:5436/staging

# ── Shadow DB admin (ephemeral clones are created/dropped here) ────────
SHADOW_ADMIN_URL=postgres://postgres:postgres@localhost:5434/postgres
# Used by the rollback integration tests:
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5434/shadow

# ── TrueForge (only for NL-intent → SQL generation; raw-SQL intake needs none) ──
TRUEFORGE_BASE_URL=http://localhost:8790
# Local server (`npx @truefoundry/trueforge`) runs with auth OFF — no token needed.
# Set this ONLY when pointing at a hosted / auth-enabled TrueForge:
TRUEFORGE_TOKEN=
# The model-provider key the TrueForge SERVER uses to run the LLM turn. Register
# it with the server (env at launch or settings.modelProviders) — model is
# anthropic/claude-sonnet-4-6. This is the key the generation step actually needs.
ANTHROPIC_API_KEY=sk-ant-...
# Daytona sandbox provider (free tier, app.daytona.io) — only needed to run
# pnpm spike:sandbox, which registers it via PUT /api/v1/settings/sandbox-providers.
DAYTONA_API_KEY=

# ── Copilot chat — BYOK, OpenAI-compatible (Euron) ─────────────────────
# Powers the read-only "Ask about this migration" copilot on the Approval
# Console. Bring your own Euron key — it is OpenAI-compatible, so EURON_BASE_URL
# can be repointed at any OpenAI-compatible endpoint. Absent key → copilot off.
EURON_API_KEY=
EURON_BASE_URL=https://api.euron.one/api/v1/euri
# Set to a model your Euron plan exposes (OpenAI-compatible id):
EURON_MODEL=gpt-4.1-nano

# ── GitHub (PR intake, optional) ───────────────────────────────────────
GITHUB_TOKEN=

# ── Qodo (code review) ─────────────────────────────────────────────────
QODO_API_KEY=

# ── Auth (single approver for the hackathon) ───────────────────────────
APPROVER_TOKEN=change-me
# Demo convenience: pre-fill the login token so the operator console is one
# click ("Login to Console") away. Must equal APPROVER_TOKEN. This is a
# NEXT_PUBLIC_ var (shipped to the browser), so leave it UNSET in a real
# deployment — an unset value keeps login a normal blank secure sign-in.
NEXT_PUBLIC_DEMO_TOKEN=change-me

# Demo-only: no-login open access to the console. OFF unless set. NEVER set
# this in a real deployment — see apps/web/lib/auth.ts.
DEMO_OPEN_ACCESS=1
